// Database configuration
// Using SQLite for local readiness
DATABASE_URL="file:./dev.db"

// JWT Secret for Auth
// IMPORTANT: Use a long, random string in production (min 32 chars)
// Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string-min-32-chars"

// AI Provider (e.g. GEMINI_API_KEY)
// IMPORTANT: Never expose this key to the frontend
GEMINI_API_KEY="your-gemini-api-key"

// Chatbot (OpenRouter) — server-side only via /api/chat, never NEXT_PUBLIC_
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# ===== WHATSAPP NOTIFICATION via Fonnte (fonnte.com) — server-side only, never NEXT_PUBLIC_ =====
# Cara pakai: daftar di fonnte.com → hubungkan nomor WA pengirim via scan QR →
# salin token dari dashboard Fonnte ke FONNTE_TOKEN di bawah.
# Nomor Admin tujuan notifikasi (format 08xx, dinormalisasi otomatis).
# Boleh memakai FONNTE_ADMIN_PHONE sebagai gantinya — keduanya dikenali.
WHATSAPP_ADMIN_NUMBER="082118727522"
FONNTE_ADMIN_PHONE="082118727522"
# Token Fonnte — GANTI dengan token asli dari dashboard Fonnte. JANGAN commit nilai aslinya.
FONNTE_TOKEN=""
# Catatan: pengiriman FOTO BUKTI (opsi "teks + foto" saat Admin menyetujui laporan)
# memakai parameter `file` Fonnte (multipart). Fitur ini memerlukan paket Fonnte yang
# mendukung media (super/advanced/ultra) dan berkas < 4 MB. Bila tidak didukung,
# pengiriman gagal dan dicatat di WhatsAppLog — status laporan TIDAK terpengaruh.
# ----- Cloud API Meta (NONAKTIF — akun dinonaktifkan Meta, dipertahankan sebagai arsip) -----
#WHATSAPP_ACCESS_TOKEN=""
#WHATSAPP_PHONE_NUMBER_ID=""
#WHATSAPP_API_VERSION="v18.0"
#WHATSAPP_TEMPLATE_REGISTER=""
#WHATSAPP_TEMPLATE_REPORT=""
#WHATSAPP_TEMPLATE_LANG="id"
# Base URL publik website untuk tautan di pesan notifikasi
# Dipakai juga untuk menyusun TAUTAN AKTIVASI akun petugas (/aktivasi) dan
# TAUTAN RESET KATA SANDI (/reset-password). Wajib diisi dengan domain publik
# pada produksi agar tautan dapat dibuka penerima.
APP_URL="http://localhost:3000"

# ===== PENJADWALAN PENGUMUMAN (cron) =====
# Endpoint /api/cron/village memproses pengumuman terjadwal & mengarsipkan yang
# kedaluwarsa (idempoten). Amankan dengan CRON_SECRET, lalu panggil berkala
# (mis. setiap 5 menit) dari cron OS / layanan scheduler hosting:
#   curl -H "x-cron-secret: <nilai CRON_SECRET>" https://domain-anda/api/cron/village
# Tanpa CRON_SECRET, endpoint hanya dapat dijalankan oleh Admin yang login.
CRON_SECRET="ganti-dengan-string-acak-panjang"

# ===== MAP CONFIGURATION =====
# Provider peta yang digunakan. Pilihan: openstreetmap | cartodb | mapbox
# - openstreetmap: gratis, tanpa API key (default)
# - cartodb: gratis, tanpa API key, tampilan lebih bersih
# - mapbox: butuh NEXT_PUBLIC_MAPBOX_TOKEN
NEXT_PUBLIC_MAP_PROVIDER="cartodb"

# Mapbox token (hanya diperlukan jika MAP_PROVIDER=mapbox)
# Dapatkan di: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=""
